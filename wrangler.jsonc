{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mandarinbridge-landing",
  "main": "worker/index.js",
  // Match the runtime bundled with the locked Wrangler version.
  "compatibility_date": "2026-10-19",
  "keep_vars": true,
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "kv_namespaces": [
    // Wrangler provisions this namespace on first deploy; local dev uses local KV.
    { "binding": "BOOKINGS" }
  ],
  // Required by `wrangler preview`. Preview KV/secrets are separate from production.
  // To test bookings, add a test BOOKINGS namespace ID as described in README.
  "previews": {},
  "observability": {
    "enabled": true
  }
}
